# --- n8n ---
N8N_VERSION=2.39.6
N8N_HOST_PORT=5678
# openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# Public base URL used in webhook URLs (set to the tunnel URL when exposing to Zoom)
WEBHOOK_URL=http://localhost:5678/
TZ=Europe/Kyiv

# --- Postgres (n8n metadata + app data) ---
POSTGRES_DB=n8n
POSTGRES_USER=n8n
# openssl rand -hex 16
POSTGRES_PASSWORD=

# --- Zoom (Marketplace app -> Features -> Access -> Secret Token) ---
ZOOM_WEBHOOK_SECRET_TOKEN=

# --- OpenAI (steps 2-3: Whisper + GPT) ---
OPENAI_API_KEY=

# --- CRM (optional, post-MVP) ---
CRM_BASE_URL=
CRM_API_TOKEN=
