    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH report AS (\n  INSERT INTO app.call_reports\n    (event_id, meeting_uuid, meeting_topic, host_email, start_time, duration_min, transcript, analysis)\n  VALUES ($1, $2, $3, $4, $5, $6, $7, $8::jsonb)\n  RETURNING id, event_id\n)\nUPDATE app.processed_events e\nSET status = 'done', updated_at = now()\nFROM report\nWHERE e.id = report.event_id\nRETURNING report.id AS report_id;",
        "options": {
          "queryReplacement": "={{ [   $('Register Event').item.json.id,   $('Normalize Recording').item.json.meeting.uuid,   $('Normalize Recording').item.json.meeting.topic,   $('Normalize Recording').item.json.meeting.host_email,   $('Normalize Recording').item.json.meeting.start_time,   $('Normalize Recording').item.json.meeting.duration_min,   $('Transcribe').item.json.text,   JSON.stringify($json.output[0].content[0].text) ] }}"
