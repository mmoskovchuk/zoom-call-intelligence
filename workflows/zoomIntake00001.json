    {
      "parameters": {
        "jsCode": "// Map Zoom recording.completed payload -> internal CallRecording contract.\nconst { body } = $('Zoom Webhook').first().json;\nconst rec = body.payload.object;\nconst files = (rec.recording_files ?? []).filter((f) => f.status === 'completed');\n\n// Prefer audio-only track (smaller, Whisper-friendly), fall back to M4A/MP4.\nconst audio =\n  files.find((f) => f.recording_type === 'audio_only') ??\n  files.find((f) => f.file_type === 'M4A') ??\n  files.find((f) => f.file_type === 'MP4');\n\nif (!audio) {\n  throw new Error(`No downloadable audio in recording ${rec.uuid}`);\n}\n\nreturn [{\n  json: {\n    idempotency_key: `${rec.uuid}:${audio.id}`,\n    source: 'zoom',\n    meeting: {\n      uuid: rec.uuid,\n      id: rec.id,\n      topic: rec.topic,\n      host_email: rec.host_email,\n      start_time: rec.start_time,\n      duration_min: rec.duration,\n    },\n    audio: {\n      file_id: audio.id,\n      file_type: audio.file_type,\n      file_extension: (audio.file_extension ?? audio.file_type).toLowerCase(),\n      file_size: audio.file_size,\n      download_url: audio.download_url,\n      download_token: body.download_token ?? null,\n    },\n    received_at: new Date().toISOString(),\n  },\n}];\n"
      },
