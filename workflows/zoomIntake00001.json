    {
      "parameters": {
        "jsCode": "// Zoom webhook signature verification + URL validation challenge.\n// Docs: https://developers.zoom.us/docs/api/webhooks/#verify-webhook-events\nconst crypto = require('crypto');\n\nconst MAX_SKEW_SEC = 300; // replay protection window\nconst secret = $env.ZOOM_WEBHOOK_SECRET_TOKEN;\nconst { headers, body } = $input.first().json;\n\nconst hmac = (msg) => crypto.createHmac('sha256', secret).update(msg).digest('hex');\nconst safeEqual = (a, b) =>\n  a.length === b.length && crypto.timingSafeEqual(Buffer.from(a), Buffer.from(b));\n\nconst ts = headers['x-zm-request-timestamp'] ?? '';\nconst signature = headers['x-zm-signature'] ?? '';\n// Zoom signs compact JSON; re-serialization matches Zoom's reference implementation.\nconst expected = `v0=${hmac(`v0:${ts}:${JSON.stringify(body)}`)}`;\nconst isFresh = Math.abs(Date.now() / 1000 - Number(ts)) <= MAX_SKEW_SEC;\nconst isValid = Boolean(secret) && isFresh && safeEqual(signature, expected);\n\nconst event = body?.event ?? 'unknown';\nlet route, response;\n\nif (!isValid) {\n  route = 'invalid';\n  response = { status: 401, body: { error: 'invalid signature' } };\n} else if (event === 'endpoint.url_validation') {\n  const plainToken = body.payload.plainToken;\n  route = 'url_validation';\n  response = { status: 200, body: { plainToken, encryptedToken: hmac(plainToken) } };\n} else if (event === 'recording.completed') {\n  route = 'recording.completed';\n  response = { status: 200, body: { status: 'accepted' } };\n} else {\n  route = 'ignored';\n  response = { status: 200, body: { status: 'ignored', event } };\n}\n\nreturn [{ json: { route, event, event_ts: body?.event_ts ?? null, response } }];\n"
      },
