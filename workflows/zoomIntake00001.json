        "responses": {
          "values": [
            {
              "role": "system",
              "content": "Ти аналізуєш транскрипти ділових дзвінків.\nВикористовуй лише факти, прямо названі в транскрипті — ніколи не вигадуй імена, дати чи задачі.\nЯкщо учасники не назвали себе, позначай їх «Учасник 1», «Учасник 2».\nУсі текстові значення пиши українською мовою, навіть якщо розмова іншою мовою."
            },
            {
              "content": "=Тема зустрічі: {{ $('Normalize Recording').item.json.meeting.topic }}\n\nТранскрипт:\n{{ $json.text }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "name": "call_analysis",
              "schema": "{\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"summary\", \"participants\", \"key_points\", \"action_items\"],\n  \"properties\": {\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"3-5 sentence summary of the call\"\n    },\n    \"participants\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"name\", \"role\"],\n        \"properties\": {\n          \"name\": { \"type\": \"string\", \"description\": \"Name as mentioned, or 'Speaker 1', 'Speaker 2'…\" },\n          \"role\": { \"type\": [\"string\", \"null\"], \"description\": \"Role/company if stated, else null\" }\n        }\n      }\n    },\n    \"key_points\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" },\n      \"description\": \"Main topics, facts, decisions\"\n    },\n    \"action_items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"task\", \"owner\", \"due\"],\n        \"properties\": {\n          \"task\": { \"type\": \"string\" },\n          \"owner\": { \"type\": [\"string\", \"null\"], \"description\": \"Who is responsible, if stated\" },\n          \"due\": { \"type\": [\"string\", \"null\"], \"description\": \"Deadline as stated, if any\" }\n        }\n      }\n    }\n  }\n}",
              "strict": true
            }
          }
        }
